# Browser-visible API origin. Next.js embeds this at build time.
NEXT_PUBLIC_SAVORA_API_BASE_URL=http://localhost:5000
# Optional in local development only: enables the legacy /en and /ar storefront routes.
# Explicit /en/r/:slug and /ar/r/:slug routes do not need this setting.
NEXT_PUBLIC_SAVORA_DEV_RESTAURANT_SLUG=savora-demo
