# Copy to .env for local development. Never commit a real URI or password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/savora_dev?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://<test-username>:<password>@<cluster>/savora_test?retryWrites=true&w=majority

# Only for the guarded development provisioning CLI.
SAVORA_DEV_ATLAS_HOSTNAME=<cluster>

# Set only for explicit interactive Admin bootstrap; must match MONGODB_URI.
ADMIN_BOOTSTRAP_DATABASE=savora_dev

# Exact browser origins, separated by commas. Use HTTPS in deployed environments.
AUTH_TRUSTED_ORIGINS=http://localhost:3000
NODE_ENV=development
TRUST_PROXY_HOPS=0
PORT=5000